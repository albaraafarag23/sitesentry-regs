# Copy this file to .env and fill in your own key. .env is in .gitignore.

# Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Claude model used to write answers
ANTHROPIC_MODEL=claude-opus-5-5

# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL=postgresql://regs:regs@localhost:5433/regs

# Hugging Face embedding model (Arabic + English, 384 dimensions)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
