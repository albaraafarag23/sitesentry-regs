# Copy this file to .env and fill in your own key. .env is in .gitignore.

# Which LLM writes the answers: gemini (free tier) or claude
LLM_PROVIDER=gemini

# Gemini API key: free at https://aistudio.google.com/apikey (no card needed)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Only needed if LLM_PROVIDER=claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL=postgresql://regs:regs@localhost:5433/regs

# Hugging Face embedding model (Arabic + English, 384 dimensions)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Only for cloud deployment (deploy/deploy_space.py) ---
# Hugging Face access token with "write" permission, and your username
HF_TOKEN=
HF_USERNAME=
# Cloud PostgreSQL with pgvector (for example Neon); starts with postgresql://
CLOUD_DATABASE_URL=
